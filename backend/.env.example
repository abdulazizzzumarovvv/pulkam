# ── Server ────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Ilovadan kelgan so'rovlar uchun JWT imzo kaliti (uzun tasodifiy satr yozing)
JWT_SECRET=change_me_to_a_long_random_string

# ── PostgreSQL ────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/pulkam

# ── Google Sign-In ────────────────────────────────────
# Google Cloud Console → OAuth client (Android + Web)dan olinadi
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# ── Click (SHOP API) — merchant kabinetdan olinadi ────
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
# Ilova qaytadigan deep link
CLICK_RETURN_URL=pulkam://payment-return

# ── PRO narxlari (so'mda) ─────────────────────────────
PRICE_OYLIK=14900
PRICE_YILLIK=159900
PRICE_UMRBOD=249900

# ── Birinchi admin (seed:admin skripti uchun) ─────────
ADMIN_EMAIL=admin@pulkam.uz
ADMIN_PASSWORD=change_this_password
